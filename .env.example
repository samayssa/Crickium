# --- Redis cache (Upstash) -------------------------------------------------
# Railway variable: REDIS_URL  (alias: DATABASE_REDIS_URL)
# Copy the *Redis* connection string from Upstash (starts with rediss://), NOT the REST url.
# Format: rediss://default:YOUR_UPSTASH_PASSWORD@your-db-name.upstash.io:6379
REDIS_URL=
# CACHE_ENABLED=1                       # set 0 to switch the whole cache off
# CACHE_REDIS_DAILY_COMMAND_LIMIT=0     # optional soft cap per process per day (0 = unlimited)
# CACHE_NAMESPACE=                      # optional suffix to isolate several bots on one Redis
# CACHE_SNAPSHOT_REDIS=1                # 0 = do not send live-match snapshots through Redis
