# Required Telegram credentials. Keep real values in Railway Variables, not Git.
API_ID=
API_HASH=
BOT_TOKEN=
DATABASE_URL=

# Optional provider-neutral PostgreSQL TLS settings.
# Default SSL mode is verify-full when neither this nor the URL specifies a mode.
DB_SSL_MODE=verify-full
# Set to a repo-relative path (or absolute path) when your provider supplies a CA.
# Example for this Supabase setup: certs/supabase-root-ca-2021.crt
DB_CA_CERT_FILE=
# Alternatives to DB_CA_CERT_FILE: base64-encoded PEM or inline PEM with \n separators.
# Leave these empty when using the certificate file.
DB_CA_CERT_B64=
DB_CA_CERT=

# Bot owner Telegram user ID
ADMIN_USER_ID=1766243373

# Mini App
MINIAPP_URL=https://your-miniapp-domain.example
DEBUG=0
MINIAPP_DEBUG_AUTH=0

# Optional existing Crickium settings
BOT_NAME=Crickium
DB_DEBUG=0
AUTO_BACKUP_ENABLED=1
# Full database exports are intentionally limited to at most once per day.
AUTO_BACKUP_INTERVAL_SECONDS=86400
# PLAYER_IMAGE_CHANNEL_ID=
# AUTO_BACKUP_CHANNEL_ID=
# NOTIFICATION_GROUP_ID=
# MAIN_GROUP_ID=
# MAIN_GROUP_LINK=
